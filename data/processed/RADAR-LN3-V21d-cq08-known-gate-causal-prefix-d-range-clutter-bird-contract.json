  ],
  "source": "sealed canonical frame provenance target_range_reference_m, equivalent to MAT debug_info.detected_range_m, plus current V16 TR filtered range_m",
  "formula": "sample std(ddof=1) of every observed frame-level (MTD detected_range_m - its current-event TR filtered range_m) in the causal prefix; divide by 75 m and clip to [0,1]",
  "causal_scope": "current and prior events only; each event receives the statistic after adding all valid frames from that event; no future event or parent-final value is read",
  "minimum_evidence": "two valid frame-level residual observations",
  "missing_policy": "missing RD or TR range contributes no new residual; an already-valid prefix statistic is carried forward; before two valid residuals the value is zero and invalid",
  "normalization": {
    "clip_m": 75.0,
    "ddof": 1
  },
  "old_v21d_proxy": {
