{
  "schema_version": "RADAR-LN3-V27-deployment-benchmark-config-v2",
  "description": "V27d-r15 v3 treatment L1、V27c-r23 robust_control L2 的串行部署基准绑定。",
  "l1": {
    "config_path": "src-v3/v27/V27d/r15/config/V27d-r15-v3-global-best.json",
    "arm": "v10_observation_increment",
    "seed": 42,
    "checkpoint_template": "src-v3/v27/V27d/r15/checkpoints/v3-global-best/V27d-r15-{arm}-seed{seed}-global-best.pt",
    "fallback_checkpoints": [
      "src-v3/v27/V27d/r15/checkpoints/v5/V27d-r15-{arm}-seed{seed}.pt",
      "src-v3/v27/V27d/r15/checkpoints/V27d-r15-{arm}-seed{seed}.pt"
    ]
  },
  "l2": {
    "config_path": "src-v3/v27/v27c/r23/config/V27c-r23-global-best.json",
    "arm": "robust_control",
    "seed": 43
  },
  "l3": {
    "registry_path": "src-v3/v27/V27d/calibration/V27d-r1-l3-registry.json",
    "required_status": "fitted"
  },
  "data": {
    "r15_validation_view": "validation",
    "r15_unknown_view": "representation_development",
    "r23_split": "val"
  },
  "rd_encoder": {
    "variants": ["all_frames", "valid_frames_only"],
    "optimized_description": "仅对 rd_frame_mask=True 的帧执行卷积，再按事件做 masked mean 聚合。"
  }
}
