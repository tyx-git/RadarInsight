{
  "schema_version": "RADAR-LN3-V27d-r6-bird-liquid-verifier-v1",
  "experiment_id": "V27d-r6-bird-liquid-verifier",
  "objective": "Compare a parameter-matched 64D GRU and Liquid V2 Bird-route verifier over deployment-matched route candidates while freezing L1/L2 endpoints.",
  "seeds": [42, 43, 44],
  "source": {
    "r5_v2_config_path": "src-v3/v27/V27d/r5_v2/config/V27d-r5-bird-route-v2.json",
    "r5_v2_manifest_path": "src-v3/v27/V27d/r5_v2/manifests/V27d-r5-bird-route-v2-manifest.json",
    "r5_v2_cache_template": "src-v3/v27/V27d/r5_v2/cache/V27d-r5-v2-control-{role}-population.pt",
    "r5_control_report_path": "src-v3/v27/V27d/r5/reports/V27d-r5-seed42-bird-route-evaluation.json",
    "r5_control_config_path": "src-v3/v27/V27d/r5/config/V27d-r5-bird-route.json",
    "r5_control_checkpoint_path": "src-v3/v27/V27d/r5/checkpoints/V27d-r5-control-seed42-bird-head.pt",
    "v27d_config_path": "src-v3/v27/V27d/config/V27d-r1-frozen-endpoint-control.json",
    "v27d_l1_endpoint_cache_template": "src-v3/v27/V27d/cache/V27d-endpoint-{role}-known_gate.pt"
  },
  "model": {
    "event_trajectory_dim": 355,
    "task_fact_dim": 7,
    "input_dim": 362,
    "hidden_dim": 64,
    "summary_dim": 672,
    "projection_dim": 32,
    "liquid_tau_min_seconds": 0.05,
    "liquid_tau_max_seconds": 30.0,
    "liquid_zero_dt_event_floor_seconds": 0.001,
    "liquid_dt_max_seconds": 120.0,
    "liquid_invalid_dt_update_mode": "bounded_observation",
    "liquid_invalid_dt_observation_gain": 0.25,
    "classification_logits_input_to_head": false,
    "softmax_input_to_head": false,
    "label_identity_input_to_head": false
  },
  "training": {
    "batch_size": 32,
    "epochs": 30,
    "learning_rate": 0.0005,
    "weight_decay": 0.001,
    "gradient_clip_norm": 5.0,
    "device": "cuda",
    "minimum_quality_events": 3
  },
  "selection": {
    "max_additional_bird_rejections_per_pool": 1,
    "min_precision_gain": 0.05,
    "min_development_unknown_rejection": 0.28125,
    "min_calibration_unknown_rejection": 0.25
  },
  "calibration": {
    "scope": "exploratory_threshold_transfer_only",
    "formal_unknown_support_required": 100,
    "formal_l3_enabled": false
  },
  "artifacts": {
    "manifest_path": "src-v3/v27/V27d/r6/manifests/V27d-r6-manifest.json",
    "cache_template": "src-v3/v27/V27d/r6/cache/V27d-r6-{role}-population.pt",
    "checkpoint_template": "src-v3/v27/V27d/r6/checkpoints/V27d-r6-{arm}-seed{seed}.pt",
    "summary_template": "src-v3/v27/V27d/r6/runs/V27d-r6-{arm}-seed{seed}-training-summary.json",
    "log_template": "src-v3/v27/V27d/r6/runs/V27d-r6-{arm}-seed{seed}.log",
    "smoke_path": "src-v3/v27/V27d/r6/reports/V27d-r6-contract-smoke.json",
    "evaluation_template": "src-v3/v27/V27d/r6/reports/V27d-r6-{arm}-seed{seed}-evaluation.json",
    "summary_report_path": "src-v3/v27/V27d/r6/reports/V27d-r6-three-seed-summary.json",
    "experiment_doc_path": "src-v3/v27/V27d/r6/experiment.md"
  },
  "protocol": {
    "direct_baseline": "V27d-r5-control",
    "unique_variable": "recurrent_core_gru_vs_liquid_v2",
    "unknown_is_classifier_class": false,
    "l1_l2_endpoints_frozen": true,
    "strict_parent_class_balanced_loss": true,
    "route_matched_population": true,
    "formal_l3_enabled": false,
    "test_payload_access_count": 0
  }
}
