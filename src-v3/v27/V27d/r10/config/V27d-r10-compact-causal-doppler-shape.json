  "model": {
    "class_names": ["DroneTarget", "BirdTarget", "BalloonTarget"],
    "descriptor_dim": 8,
    "descriptor_names": [
      "profile_centroid_over_90mps",
      "profile_spread_over_90mps",
      "profile_entropy_over_log_181",
      "profile_signed_positive_negative_balance",
      "profile_top4_mass",
      "profile_scaled_rms",
