    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "gradient_clip_norm": 10.0,
    "bootstrap_replicates": 1000,
    "device": "cuda",
    "loss_name": "parent_final_fixed_parent_count_ce",
    "loss_reduction": "fixed_parent_count",
    "class_weights": [0.6673669467787114, 1.3291492329149233, 1.334733893557423]
  },
  "promotion": {
    "minimum_bird_recall": 0.96,
    "maximum_new_errors": 0,
    "minimum_drone_bird_corrections": 1,
    "minimum_total_correct_gain": 1,
    "require_all_seeds": true
