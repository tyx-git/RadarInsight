    "r19_checkpoint_epoch": 20
  },
  "data": {
    "dataset": "OriData/excel/TR-only-processed-r17",
    "split_protocol": "r18 sealed source_suffix+label parent split",
    "snr_protocol": "r19 snr_missing_only",
    "untrusted_excel_noise_policy": "exclude Noise and derived SNR",
    "raw_radial_speed_field": "radial_speed_mps",
    "radial_scalar_removed": true,
    "radial_value_names": [
      "abs_radial_speed_scaled",
      "radial_speed_sign",
      "radial_speed_rate_scaled",
      "radial_range_direction_consistency"
    ],
    "radial_valid_names": [
      "abs_radial_speed_scaled_valid",
      "radial_speed_sign_valid",
      "radial_speed_rate_scaled_valid",
      "radial_range_direction_consistency_valid"
    ],
    "radial_sidecar_dim": 4,
    "radial_sidecar_input_dim": 8,
    "radial_abs_scale_mps": 100.0,
    "radial_rate_scale_mps_per_s": 100.0,
    "sidecar_clip_absolute": 5.0,
    "positive_dt_only_for_rate_and_consistency": true,
    "zero_dt_rate_and_consistency_policy": "value_zero_and_valid_false",
    "missing_radial_policy": "value_zero_and_valid_false_for_affected_fields",
    "unknown_training_exposure": 0,
    "test_created": false
  },
  "model": {
    "task": "dbb_specialist",
    "class_names": ["DroneTarget", "BirdTarget", "BalloonTarget"],
    "radial_projection_dim": 16,
    "radial_adapter_dim": 16,
    "bias_free": true,
    "output_zero_initialization": true,
    "injection": "post_fusion_pre_liquid",
    "validity_mask_is_model_input": true,
    "unknown_classifier_class": false,
    "trajectory_heads": "frozen_unused_by_classification"
  },
  "training": {
    "seeds": [42],
    "batch_size": 4,
    "epochs": 20,
    "gradient_clip_norm": 100.0,
    "l2_learning_rate": 0.00001,
    "weight_decay": 0.001,
    "loss_name": "parent_final_fixed_parent_count_ce",
    "loss_reduction": "fixed_parent_count",
    "optimizer": "AdamW",
    "device": "cuda",
    "checkpoint_selection": "validation_parent_macro_f1_then_min_recall"
  },
  "artifacts": {
