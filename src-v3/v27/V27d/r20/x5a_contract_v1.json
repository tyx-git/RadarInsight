{
  "schema_version": "RADAR-LN3-X5A-data-contract-v1",
  "contract_status": "draft_blocked_pending_vendor_schema_and_label_sidecar",
  "dataset": {
    "name": "Liangzi Lake X5A",
    "root": "OriData/梁子湖X5A",
    "file_glob": "*.dat",
    "expected_file_count": 8,
    "source_system": "X5A radar capture; exact firmware and protocol version pending confirmation",
    "record_index": {
      "required": true,
      "path": "src-v3/v27/V27d/r20/manifests/V27d-r20-x5a-record-index.json",
      "sha256": "a831fc9ae254aeb771fffd1791867ac3e2ff46c92bbd9d62c52f3f631f7a0b9a",
      "schema_version": "RADAR-LN3-X5A-record-index-v1",
      "purpose": "精确校验变长 record 内 point_id 边界"
    },
    "label_sidecar": {
      "required": true,
      "path": null,
      "join_keys": ["file_id", "record_id", "point_id"],
      "allowed_labels": ["DroneTarget", "BirdTarget", "BalloonTarget", "ClutterTarget", "UnknownTarget"],
      "minimum_join_coverage": 0.995,
      "minimum_manual_audit_sample": 200
    }
  },
  "record_layout": {
    "endianness": "little",
    "record_magic": {
      "offset": 0,
      "dtype": "bytes[4]",
      "expected_hex": "bbbbbbbb",
      "status": "verified"
    },
    "record_length": {
      "offset": 4,
      "dtype": "uint16",
      "formula": "record_bytes = uint16_le(offset=4) + 18",
      "status": "verified"
    },
    "secondary_magic": {
      "offset": 18,
      "dtype": "bytes[4]",
      "expected_hex": "aaaaaaaa",
      "status": "verified"
    },
    "point_count": {
      "offset": 22,
      "dtype": "uint32",
      "formula": "point_count = uint32_le(offset=22) + 1",
      "status": "verified_against_record_length"
    },
    "frame_or_tick_candidate": {
      "offset": 26,
      "dtype": "uint32",
      "status": "candidate_pending_protocol",
      "quality_rule": "must declare wrap/reset semantics before temporal modeling"
    },
    "variant_marker": {
      "offset": 30,
      "dtype": "bytes[4]",
      "observed_hex": ["0a0d0e01", "1e0d0e01", "0a3d0100"],
      "status": "observed_pending_semantics"
    },
    "fixed_header_candidate": {
      "offset": 34,
      "dtype": "uint16[8]",
      "status": "candidate_pending_protocol"
    },
    "point_payload": {
      "offset": 50,
      "dtype": "uint16[12]",
      "bytes_per_point": 24,
      "field_names": ["u16_00", "u16_01", "u16_02", "u16_03", "u16_04", "u16_05", "u16_06", "u16_07", "u16_08", "u16_09", "u16_10", "u16_11"],
      "status": "layout_verified_semantics_pending"
    }
  },
  "fields": [
    {"name": "u16_00", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 0", "status": "pending_vendor_schema"},
    {"name": "u16_01", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 2", "status": "pending_vendor_schema"},
    {"name": "u16_02", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 4", "status": "pending_vendor_schema"},
    {"name": "u16_03", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 6", "status": "pending_vendor_schema"},
    {"name": "u16_04", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 8", "status": "pending_vendor_schema"},
    {"name": "u16_05", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 10", "status": "pending_vendor_schema"},
    {"name": "u16_06", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 12", "status": "pending_vendor_schema"},
    {"name": "u16_07", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 14", "status": "pending_vendor_schema", "observed_saturation_code": 65535},
    {"name": "u16_08", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 16", "status": "pending_vendor_schema"},
    {"name": "u16_09", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 18", "status": "pending_vendor_schema"},
    {"name": "u16_10", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 20", "status": "pending_vendor_schema"},
    {"name": "u16_11", "dtype": "uint16", "unit": null, "scale": null, "valid_range": null, "invalid_codes": [], "source": "point_payload offset 22", "status": "pending_vendor_schema"}
  ],
  "quality_requirements": {
    "file_readability": {"rule": "all declared records consume exactly the file size", "severity": "P0"},
    "record_magic_match_rate": {"minimum": 1.0, "severity": "P0"},
    "length_point_count_consistency": {"minimum": 1.0, "severity": "P0"},
    "finite_numeric_rate": {"minimum": 1.0, "severity": "P0"},
    "label_join_coverage": {"minimum": 0.995, "severity": "P0"},
    "negative_time_delta_rate": {"maximum": 0.0, "severity": "P0", "scope": "after tick semantics are confirmed"},
    "duplicate_point_key_rate": {"maximum": 0.0, "severity": "P0"},
    "saturation_rate": {"action": "report_and_mask_until_protocol_confirms meaning", "severity": "P1"},
    "zero_pattern_rate": {"action": "report; do not delete without labels", "severity": "P1"},
    "cross_file_distribution_shift": {"action": "report robust quantile shift and stratify validation", "severity": "P1"}
  },
  "processing_rules": {
    "raw_data": "immutable; never overwrite source .dat",
    "unknown_field_semantics": "keep candidate offset name only",
    "invalid_values": "preserve raw value, emit valid_mask, exclude from physical statistics after confirmation",
    "record_scope": "compute density within record or confirmed scan window; never concatenate records implicitly",
    "time_scope": "compute continuity only within confirmed scan/track scope",
    "denoising_default": "audit_only; no hard deletion",
    "excel_noise_field": "untrusted until source calibration; do not derive production SNR"
  },
  "required_confirmation_items": [
    {"id": "X5A-P0-01", "priority": "P0", "item": "vendor protocol and firmware version", "owner": "设备/采集系统", "evidence": "protocol document or signed field map"},
    {"id": "X5A-P0-02", "priority": "P0", "item": "u16_00..u16_11 physical meanings, units and scale", "owner": "设备/算法", "evidence": "field map plus calibration sample"},
    {"id": "X5A-P0-03", "priority": "P0", "item": "invalid/saturation/zero code semantics", "owner": "设备/算法", "evidence": "protocol and annotated examples"},
    {"id": "X5A-P0-04", "priority": "P0", "item": "tick/frame wrap, reset and scan-window semantics", "owner": "设备/采集系统", "evidence": "timing specification and replay check"},
    {"id": "X5A-P0-05", "priority": "P0", "item": "point/record/scan label sidecar and join key", "owner": "标注/数据", "evidence": "sidecar with >=99.5% join coverage"},
    {"id": "X5A-P1-01", "priority": "P1", "item": "variant marker meanings", "owner": "设备", "evidence": "examples for each marker"},
    {"id": "X5A-P1-02", "priority": "P1", "item": "coordinate reference and axis convention", "owner": "设备/算法", "evidence": "calibration target or known trajectory"},
    {"id": "X5A-P1-03", "priority": "P1", "item": "record scope and multi-target mixing rule", "owner": "采集/标注", "evidence": "capture protocol"},
    {"id": "X5A-P2-01", "priority": "P2", "item": "protocol/firmware/hash provenance in every batch", "owner": "数据平台", "evidence": "manifest and immutable metadata"}
  ]
}
