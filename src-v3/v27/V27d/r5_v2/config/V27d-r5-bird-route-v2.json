{
  "schema_version": "RADAR-LN3-V27d-r5-bird-route-v2-v1",
  "experiment_id": "V27d-r5-bird-route-v2",
  "seed": 42,
  "objective": "Audit the frozen r5 control Bird-route errors and test one causal prefix-consistency objective without changing L1, L2 or classification endpoints.",
  "source": {
    "r5_config_path": "src-v3/v27/V27d/r5/config/V27d-r5-bird-route.json",
    "r5_manifest_path": "src-v3/v27/V27d/r5/manifests/V27d-r5-manifest.json",
    "r5_report_path": "src-v3/v27/V27d/r5/reports/V27d-r5-seed42-bird-route-evaluation.json",
    "r5_population_cache_template": "src-v3/v27/V27d/r5/cache/V27d-r5-control-{role}-population.pt",
    "v27d_config_path": "src-v3/v27/V27d/config/V27d-r1-frozen-endpoint-control.json",
    "v27d_endpoint_cache_template": "src-v3/v27/V27d/cache/V27d-endpoint-{role}-dbb_specialist.pt"
  },
  "model": {
    "hidden_dim": 48,
    "projection_dim": 32,
    "stable8_enabled": false,
    "classification_logits_input_to_head": false,
    "softmax_input_to_head": false,
    "label_identity_input_to_head": false
  },
  "training": {
    "batch_size": 32,
    "epochs": 30,
    "learning_rate": 0.0005,
    "weight_decay": 0.001,
    "gradient_clip_norm": 5.0,
    "device": "cuda",
    "minimum_quality_events": 3,
    "prefix_consistency_weight": 0.35,
    "unknown_terminal_uplift_weight": 0.35,
    "unknown_terminal_uplift_margin": 0.05
  },
  "selection": {
    "bird_recall_floor": 0.98,
    "max_correct_bird_new_rejections": 2,
    "calibration_max_additional_correct_bird_rejections": 0
  },
  "audit": {
    "r5_threshold_score": "bird_knownness_probability",
    "single_event_contribution_flag": 0.5,
    "prefix_score_range_flag": 0.2,
    "prefix_reversal_count_flag": 2,
    "stable8_event_delta_p90_flag": 2.0
  },
  "calibration": {
    "scope": "exploratory_threshold_transfer_only",
    "formal_unknown_support_required": 100,
    "formal_l3_enabled": false
  },
  "artifacts": {
    "manifest_path": "src-v3/v27/V27d/r5_v2/manifests/V27d-r5-bird-route-v2-manifest.json",
    "cache_template": "src-v3/v27/V27d/r5_v2/cache/V27d-r5-v2-control-{role}-population.pt",
    "checkpoint_path": "src-v3/v27/V27d/r5_v2/checkpoints/V27d-r5-bird-route-v2-control-seed42.pt",
    "summary_path": "src-v3/v27/V27d/r5_v2/runs/V27d-r5-bird-route-v2-control-seed42-training-summary.json",
    "log_path": "src-v3/v27/V27d/r5_v2/runs/V27d-r5-bird-route-v2-control-seed42.log",
    "audit_path": "src-v3/v27/V27d/r5_v2/reports/V27d-r5-bird-route-v2-seed42-error-audit.json",
    "smoke_path": "src-v3/v27/V27d/r5_v2/reports/V27d-r5-bird-route-v2-contract-smoke.json",
    "evaluation_path": "src-v3/v27/V27d/r5_v2/reports/V27d-r5-bird-route-v2-seed42-evaluation.json",
    "experiment_doc_path": "src-v3/v27/V27d/r5_v2/experiment.md"
  }
}
