{
  "project": {
    "name": "RadarInsight",
    "data_root": "data",
    "device": "cuda",
    "num_workers": 0,
    "seed": 42,
    "target": {
      "primary_metric": "low_altitude_drone_bird_accuracy",
      "primary_goal": 0.95,
      "selection_metric": "macro_f1",
      "notes": [
        "低空核心任务优先优化 DroneTarget / BirdTarget / BalloonTarget / ClutterTarget / UnknownTarget。",
        "system 总准确率会被 CQ08 大样本主导，必须同时查看 per_class、by_source、route per_route。",
        "Unknown 拒识阈值先关闭硬规则，单独完成阈值校准后再打开。"
      ]
    }
  },
  "data": {
    "processed_root": "data/processed",
    "system_index": "system_trainable_track_index.csv",
    "expert1_index": "expert1_track_index.csv",
    "cq08_grouped_split": "data/manifests/cq08_grouped_split.json",
    "split_policy": "grouped_cq08_plus_stratified_other",
    "forbidden": [
      "RD frame-level random split",
      "test-time label-dependent logits",
      "hard Unknown reject before threshold calibration"
    ]
  },
  "pretrain_track": {
    "output_dir": "artifacts/pretrain_track",
    "epochs": 8,
    "batch_size": 16,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "model_dim": 128,
    "dropout": 0.1,
    "mask_ratio": 0.15,
    "contrastive_temperature": 0.1,
    "mtm_loss_weight": 1.0,
    "contrastive_loss_weight": 0.2
  },
  "router": {
    "output_dir": "artifacts/router_v1",
    "epochs": 3,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "balanced_sampling": true,
    "coarse_loss_weight": 0.3,
    "max_grad_norm": 1.0,
    "input": "17_dim_explicit_physical_features",
    "selection_metric": "macro_route_recall",
    "notes": [
      "不要只看 route_accuracy；low_altitude 样本占比过高，route_accuracy 容易虚高。",
      "router checkpoint 应完整加载到 system.router，pretrained_router_info 不能有 skipped_shape_mismatch。"
    ]
  },
  "expert1": {
    "output_dir": "artifacts/expert1_config_smoke",
    "epochs": 10,
    "batch_size": 8,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "dropout": 0.1,
    "source_normalization": true,
    "sequence_encoder_lr_multiplier": 0.1,
    "pretrained_track_checkpoint": "artifacts/pipeline_arch_review_smoke/20260427-184355/pretrain_track/best_model.pt",
    "freeze_track_encoder_epochs": 0,
    "stage1_traj_only_epochs": 1,
    "stage2_ramp_epochs": 1,
    "prefer_stage2_checkpoint": true,
    "use_rd_patch_cnn": true,
    "low_altitude_traj_aux_ratio": 0.35,
    "low_altitude_rd_aux_ratio": 0.65,
    "low_altitude_rd_hard_aux_weight": 0.5,
    "low_altitude_rd_focal_gamma": 1.5,
    "low_altitude_rd_binary_aux_weight": 0.62,
    "low_altitude_rd_pairwise_aux_weight": 0.8,
    "low_altitude_rd_unknown_pairwise_aux_weight": 0.65,
    "low_altitude_rd_clutter_pairwise_aux_weight": 1.1,
    "low_altitude_rd_rare_margin_aux_weight": 0.85,
    "low_altitude_rd_rare_margin": 0.45,
    "low_altitude_rd_forced_fusion_weight": 0.75,
    "low_altitude_rd_gate_aux_weight": 0.0,
    "low_altitude_rd_gate_temperature": 0.5,
    "low_altitude_rd_rare_gate_floor": 0.15,
    "low_altitude_traj_anchor_weight": 0.0,
    "low_altitude_traj_anchor_start_epoch": 2,
    "min_rd_macro_f1_for_best": 0.22,
    "min_drone_bird_rd_recall_for_best": 0.3,
    "min_drone_bird_single_rd_recall_for_best": 0.2,
    "min_unknown_clutter_rd_recall_for_best": 0.1,
    "min_rare_rd_recall_for_best": 0.05,
    "min_without_rd_accuracy_for_best": 0.72,
    "min_source_accuracy_for_best": 0.5,
    "require_final_not_worse_than_traj": true,
    "max_final_traj_f1_drop": 0.02,
    "rd_activation_threshold": 1.01,
    "rd_bird_logit_scale": 0.75,
    "rd_unknown_logit_scale": 1.0,
    "rd_clutter_logit_scale": 1.3,
    "rd_sample_boost": 2.0,
    "raw_source_boost": 2.0,
    "excel_source_boost": 2.0,
    "cq08_source_boost": 1.0,
    "unknown_sample_boost": 2.2,
    "clutter_sample_boost": 3.2,
    "bird_sample_boost": 1.9,
    "unknown_loss_weight": 1.05,
    "rd_bird_positive_weight": 4.5,
    "rd_unknown_positive_weight": 4.5,
    "rd_clutter_positive_weight": 8.0,
    "low_altitude_mutual_exclude_rare_classes": true,
    "low_altitude_aux_weight": 0.5,
    "low_altitude_mutual_weight": 1.0,
    "low_altitude_contrastive_weight": 0.2,
    "low_altitude_temperature": 0.1,
    "cosface_scale": 16.0,
    "cosface_margin": 0.2,
    "enable_reject_in_train": false,
    "enable_reject_in_eval": false,
    "reject_threshold": 0.35,
    "skip_non_finite_batch": true,
    "candidate_overrides": {
      "highest_accuracy": {
        "unknown_sample_boost": 1.0,
        "unknown_loss_weight": 0.5,
        "rd_activation_threshold": 0.8
      },
      "balanced_unknown": {
        "unknown_sample_boost": 1.7,
        "unknown_loss_weight": 0.8,
        "rd_activation_threshold": 0.8
      },
      "max_rd_fusion_probe": {
        "unknown_sample_boost": 1.7,
        "unknown_loss_weight": 0.8,
        "rd_activation_threshold": 1.01
      }
    }
  },
  "system": {
    "output_dir": "artifacts/system_config_smoke",
    "epochs": 3,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "hidden_dim": 128,
    "dropout": 0.1,
    "source_normalization": true,
    "sequence_encoder_lr_multiplier": 0.1,
    "pretrained_track_checkpoint": "artifacts/pipeline_arch_review_smoke/20260427-184355/pretrain_track/best_model.pt",
    "pretrained_router_checkpoint": "artifacts/20260428-000718/router_v1/best_model.pt",
    "expert1_checkpoint": "artifacts/20260428-121025/expert1_config_smoke/best_model.pt",
    "expert2_checkpoint": "artifacts/20260428-201240/expert2_config_smoke/best_model.pt",
    "expert4_checkpoint": "artifacts/20260501-211707/expert4_config_smoke/best_model.pt",
    "freeze_track_encoder_epochs": 1,
    "fusion_mode": "soft_log_weighted",
    "eval_fusion_candidate_modes": [
      "soft_log_weighted",
      "ungated",
      "soft_top2",
      "reroute"
    ],
    "aircraft_protection_enabled": true,
    "aircraft_confidence_tau_high": 0.1,
    "aircraft_confidence_tau_low": -0.05,
    "aircraft_conventional_gate_floor": 0.1,
    "aircraft_temperature": 1.0,
    "groundness_protection_enabled": false,
    "groundness_confidence_tau_high": 0.1,
    "groundness_confidence_tau_low": -0.05,
    "ground_route_gate_floor": 0.1,
    "groundness_temperature": 1.0,
    "reroute_max_passes": 3,
    "reroute_penalty": 3.0,
    "reroute_max_total_penalty": 6.0,
    "reroute_low_altitude_conf_threshold": 0.35,
    "reroute_conventional_air_conf_threshold": 0.35,
    "reroute_ground_conf_threshold": 0.5,
    "freeze_router": true,
    "stage_warmup_epochs": 0,
    "stage_expert_warmup_epochs": 0,
    "stage_joint_epochs": 2,
    "joint_loss_ramp_epochs": 2,
    "freeze_non_router_in_warmup": true,
    "freeze_non_low_altitude_in_expert_warmup": true,
    "freeze_router_in_expert_warmup": true,
    "freeze_track_encoder_in_expert_warmup": true,
    "route_loss_weight": 0.3,
    "route_coarse_loss_weight": 0.3,
    "low_altitude_aux_weight": 0.5,
    "low_altitude_mutual_weight": 1.0,
    "low_altitude_contrastive_weight": 0.2,
    "low_altitude_temperature": 0.1,
    "low_altitude_cosface_scale": 16.0,
    "low_altitude_cosface_margin": 0.2,
    "low_altitude_reject_threshold": 0.35,
    "low_altitude_rd_activation_threshold": 0.8,
    "low_altitude_use_rd_patch_cnn": true,
    "enable_low_altitude_reject_in_train": false,
    "enable_low_altitude_reject_in_eval": false,
    "consistency_loss_weight": 0.3,
    "stage_expert_warmup_route_loss_scale": 0.0,
    "stage_expert_warmup_low_altitude_aux_scale": 1.0,
    "stage_expert_warmup_low_altitude_mutual_scale": 1.0,
    "stage_expert_warmup_low_altitude_contrastive_scale": 1.0,
    "stage_expert_warmup_consistency_scale": 1.0,
    "stage_finetune_route_loss_scale": 0.5,
    "stage_finetune_low_altitude_aux_scale": 0.5,
    "stage_finetune_low_altitude_mutual_scale": 0.5,
    "stage_finetune_low_altitude_contrastive_scale": 0.5,
    "stage_finetune_consistency_scale": 0.5,
    "sequence_encoder_grad_clip_norm": 0.25,
    "global_grad_clip_norm": 1.0,
    "skip_non_finite_batch": true,
    "checkpoint_policy": {
      "pretrained_track_checkpoint": "artifacts/pipeline_arch_review_smoke/20260427-184355/pretrain_track/best_model.pt",
      "pretrained_router_checkpoint": "artifacts/20260428-000718/router_v1/best_model.pt",
      "expert1_checkpoint": "artifacts/20260428-121025/expert1_config_smoke/best_model.pt",
      "expert2_checkpoint": "artifacts/20260428-201240/expert2_config_smoke/best_model.pt",
      "expert4_checkpoint": "artifacts/20260501-211707/expert4_config_smoke/best_model.pt",
      "shared_encoder_priority": [
        "expert1_checkpoint",
        "pretrained_track_checkpoint",
        "system_training"
      ],
      "do_not_override_shared_encoder_from": [
        "expert2_checkpoint",
        "expert4_checkpoint"
      ],
      "latest_rejected_expert1_probe": "artifacts\\20260427-225253\\expert1_config_smoke\\fallback_model.pt"
    }
  },
  "expert2": {
    "output_dir": "artifacts/expert2_config_smoke",
    "epochs": 8,
    "batch_size": 16,
    "learning_rate": 0.0002,
    "source_normalization": true,
    "train_representation_builder": false,
    "shared_representation_checkpoint": "artifacts/20260428-121025/expert1_config_smoke/best_model.pt",
    "balanced_sampling": true,
    "balanced_positive_multiplier": 8,
    "focal_loss_gamma": 1.5,
    "negative_class_weight": 1.0,
    "positive_class_weight": 14.0,
    "aircraft_positive_noise_std": 0.01,
    "open_set_aircraft": true,
    "open_set_logit_scale": 10.0,
    "open_set_initial_threshold": 0.35,
    "threshold_min": -0.2,
    "threshold_max": 0.8,
    "threshold_steps": 101,
    "selection_metric": "aircraft_macro_f1",
    "negative_classes": [
      "DroneTarget",
      "BirdTarget",
      "BalloonTarget",
      "ClutterTarget",
      "UnknownTarget",
      "PeopleTarget",
      "CarTarget",
      "ShipTarget"
    ]
  },
  "expert4": {
    "output_dir": "artifacts/expert4_config_smoke",
    "epochs": 4,
    "batch_size": 16,
    "learning_rate": 0.0002,
    "source_normalization": true,
    "train_representation_builder": false,
    "shared_representation_checkpoint": "artifacts/20260428-121025/expert1_config_smoke/best_model.pt",
    "include_ground_hard_negatives": true,
    "groundness_loss_weight": 0.7,
    "groundness_positive_weight": 1.0,
    "groundness_negative_weight": 1.5,
    "groundness_initial_threshold": 0.5,
    "groundness_threshold_min": 0.2,
    "groundness_threshold_max": 0.9,
    "groundness_threshold_steps": 71
  },
  "pipeline": {
    "output_root": "artifacts/main_pipeline_config_smoke",
    "pretrain_enabled": true,
    "router_enabled": true,
    "expert1_enabled": true,
    "expert2_enabled": true,
    "expert4_enabled": true,
    "system_enabled": true,
    "pretrain_output_dir": "artifacts/main_pipeline_config_smoke/pretrain_track",
    "router_output_dir": "artifacts/main_pipeline_config_smoke/router_v1",
    "expert1_output_dir": "artifacts/main_pipeline_config_smoke/expert1_v1",
    "expert2_output_dir": "artifacts/main_pipeline_config_smoke/expert2_air",
    "expert4_output_dir": "artifacts/main_pipeline_config_smoke/expert4_ground",
    "system_output_dir": "artifacts/main_pipeline_config_smoke/system_v1"
  },
  "recommended_commands": {
    "pretrain_track": ".\\.venv\\Scripts\\python.exe -m src.core.train_pretrain_track --config config/config.json",
    "router": ".\\.venv\\Scripts\\python.exe -m src.core.train_router --config config/config.json",
    "expert1": ".\\.venv\\Scripts\\python.exe -m src.core.train_expert1 --config config/config.json",
    "expert2": ".\\.venv\\Scripts\\python.exe -m src.core.train_expert2 --config config/config.json",
    "expert4": ".\\.venv\\Scripts\\python.exe -m src.core.train_expert4 --config config/config.json",
    "system": ".\\.venv\\Scripts\\python.exe -m src.core.train_system --config config/config.json",
    "pipeline": ".\\.venv\\Scripts\\python.exe -m src.core.train_main_pipeline --config config/config.json"
  }
}
