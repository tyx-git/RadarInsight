{
  "project": {
    "name": "RadarInsight",
    "data_root": "data",
    "device": "cuda",
    "num_workers": 0,
    "seed": 42,
    "target": {
      "primary_metric": "low_altitude_drone_bird_accuracy",
      "primary_goal": 0.95,
      "selection_metric": "macro_f1",
      "notes": [
        "低空核心任务优先优化 DroneTarget / BirdTarget / BalloonTarget / ClutterTarget / UnknownTarget。",
        "system 总准确率会被 CQ08 大样本主导，必须同时查看 per_class、by_source、route per_route。",
        "Unknown 拒识阈值先关闭硬规则，单独完成阈值校准后再打开。"
      ]
    }
  },
  "data": {
    "processed_root": "data/processed",
    "system_index": "system_trainable_track_index.csv",
    "expert1_index": "expert1_track_index.csv",
    "cq08_grouped_split": "data/manifests/cq08_grouped_split.json",
    "split_policy": "grouped_cq08_plus_stratified_other",
    "forbidden": [
      "RD frame-level random split",
      "test-time label-dependent logits",
      "hard Unknown reject before threshold calibration"
    ]
  },
  "pretrain_track": {
    "output_dir": "artifacts/pretrain_track",
    "epochs": 8,
    "batch_size": 16,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "model_dim": 128,
    "dropout": 0.1,
    "mask_ratio": 0.15,
    "contrastive_temperature": 0.1,
    "mtm_loss_weight": 1.0,
    "contrastive_loss_weight": 0.2
  },
  "router": {
    "output_dir": "artifacts/router_v1",
    "epochs": 8,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "balanced_sampling": true,
    "coarse_loss_weight": 0.3,
    "max_grad_norm": 1.0,
    "input": "17_dim_explicit_physical_features",
    "selection_metric": "macro_route_recall",
    "notes": [
      "不要只看 route_accuracy；low_altitude 样本占比过高，route_accuracy 容易虚高。",
      "router checkpoint 应完整加载到 system.router，pretrained_router_info 不能有 skipped_shape_mismatch。"
    ]
  },
